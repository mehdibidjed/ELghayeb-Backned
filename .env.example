NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://elghayeb:elghayeb@localhost:5432/elghayeb?schema=public
REDIS_URL=redis://localhost:6379

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Python AI service (ai-service/, wraps ../vision_model)
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=60000

# Raspberry Pi Zero camera gateway (ws://<host>:3000/ws/device?token=...)
DEVICE_HEARTBEAT_TIMEOUT_MS=75000
DEVICE_CAPTURE_TIMEOUT_MS=30000
DEVICE_MAX_FRAME_BYTES=8388608
ATTENDANCE_SHOTS=3
ATTENDANCE_PAN_ANGLES=-40,0,40
ATTENDANCE_COUNTDOWN_S=3
BEHAVIOR_INTERVAL_MS=10000

# false = run `npm run worker` as a separate process
RUN_WORKERS=true

# Seed (npm run db:seed)
SEED_ADMIN_EMAIL=admin@elghayeb.local
SEED_ADMIN_PASSWORD=admin12345
