{
  "name": "el-ghayeb-backend",
  "version": "0.1.0",
  "description": "El Ghayeb backend: Raspberry Pi Zero camera gateway, attendance/behavior pipeline and REST + realtime API",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/jobs/worker.js",
    "simulate:device": "node scripts/device-simulator.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "node --test \"test/**/*.test.js\""
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "bullmq": "5.66.0",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "socket.io": "4.8.1",
    "ws": "8.18.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "msgpackr-extract@3.0.7": true
  }
}
